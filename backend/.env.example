# ===========================================================================
# MEDIQ-AI - Cấu hình biến môi trường mẫu (.env.example)
# ===========================================================================
# Hướng dẫn:
# 1. File .env thật đã nằm trong .gitignore — KHÔNG commit lên git.
# 2. Toàn bộ các service đã được cấu hình tự động nạp file .env từ thư mục gốc
#    hoặc thư mục riêng của từng service khi chạy lệnh `.\mvnw spring-boot:run`.
# ===========================================================================

# --- Cấu hình kết nối MySQL (Dùng với MySQL Workbench / MySQL local) ---
# Bắt buộc: Điền mật khẩu MySQL của máy bạn (mặc định máy local: root)
DB_PASSWORD=your-mysql-password

# Tuỳ chọn: Mặc định đã là localhost:3306 và user root
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root

# --- Cấu hình JWT (Xác thực người dùng) ---
# Tạo secret ngẫu nhiên, ví dụ: openssl rand -base64 64
JWT_SECRET=your-random-base64-jwt-secret
JWT_EXPIRATION=86400000

# --- Cấu hình gửi Mail OTP qua Gmail SMTP (auth-service) ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# --- Cấu hình Gemini AI API Key (ai-service) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Cấu hình Cloudinary Upload ảnh (media-service) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================================================
# HƯỚNG DẪN CHẠY THỦ CÔNG CÁC SERVICE BẰNG TERMINAL
# ===========================================================================
# Cách 1: Đứng tại thư mục service bất kỳ:
#     cd D:\MEDIQ-AI-full\MEDIQ-AI\backend\<tên-service>
#     .\mvnw spring-boot:run
#
# Cách 2: Đứng tại thư mục gốc backend (áp dụng cho module con):
#     cd D:\MEDIQ-AI-full\MEDIQ-AI\backend
#     .\mvnw spring-boot:run -pl doctor-service
#     .\mvnw spring-boot:run -pl scheduling-service
#     .\mvnw spring-boot:run -pl appointment-service
# ===========================================================================
